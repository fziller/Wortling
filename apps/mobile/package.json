{
  "name": "wortling-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "words:import": "yarn words:import:5",
    "words:import:5": "node scripts/import-dwds-words.mjs --length=5 --output=src/games/between/generated/allowedGuesses.ts",
    "words:import:6": "node scripts/import-dwds-words.mjs --length=6 --output=src/games/wortcode/generated/allowedGuesses.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:prod:ios": "expo run:ios --configuration Release && npx sentry-expo-upload-sourcemaps",
    "build:prod:android": "expo run:android --variant release && npx sentry-expo-upload-sourcemaps",
    "sentry:upload": "npx sentry-expo-upload-sourcemaps",
    "eas:build": "eas build --platform all --profile production",
    "eas:build:dev": "eas build --platform all --profile development",
    "eas:build:preview": "eas build --platform all --profile preview",
    "eas:update": "eas update --channel production --message \"OTA update\"",
    "eas:submit": "eas submit --platform all --profile production",
    "eas:doctor": "eas doctor",
    "version:bump": "node scripts/version.mjs bump",
    "version:set": "node scripts/version.mjs set"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~7.11.0",
    "expo": "~57.0.14",
    "expo-application": "~57.0.2",
    "expo-constants": "~57.0.12",
    "expo-dev-client": "~57.0.13",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.4",
    "expo-font": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-localization": "~57.0.1",
    "expo-notifications": "~57.0.12",
    "expo-router": "~57.0.14",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "posthog-react-native": "^4.63.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}

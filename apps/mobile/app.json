{
  "expo": {
    "name": "Wortling",
    "slug": "wortling",
    "version": "0.1.0",
    "icon": "./assets/app-icon.png",
    "orientation": "portrait",
    "scheme": "wortling",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "icon": "./assets/app-icon.png",
      "bundleIdentifier": "com.existuus.wortling"
    },
    "android": {
      "package": "com.existuus.wortling",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F1E8"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FF6B2C",
          "image": "./assets/adaptive-icon.png",
          "imageWidth": 260
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "updates": {
      "url": "https://expo.dev/projects/@fziller/wortling/updates",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
